{
  "name": "jiggle.js",
  "version": "0.2.0",
  "description": "Composable 2D particle physics for canvas",
  "type": "module",
  "main": "dist/jiggle.umd.js",
  "module": "dist/jiggle.esm.js",
  "exports": {
    ".": {
      "import": "./dist/jiggle.esm.js",
      "require": "./dist/jiggle.umd.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "demo": "npx serve . --listen 3000",
    "test": "node --test",
    "ci": "npm test && npm run build"
  },
  "keywords": [
    "canvas",
    "physics",
    "particles",
    "animation",
    "2d"
  ],
  "author": "Fabrice Roncoroni",
  "license": "MIT",
  "devDependencies": {
    "rollup": "^4.0.0"
  },
  "types": "dist/jiggle.d.ts"
}
